{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Clean Resume Files",
            "type": "shell",
            "command": "sh",
            "args": [
                "-c",
                "latexmk -C -outdir=short short/vladimir_sirghi_short.tex && latexmk -C -outdir=detailed detailed/vladimir_sirghi_detailed.tex"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build Detailed Resume",
            "type": "shell",
            "command": "latexmk",
            "args": [
                "-pdf",
                "-outdir=detailed",
                "detailed/vladimir_sirghi_detailed.tex"
            ],
            "problemMatcher": [
                {
                    "owner": "latex",
                    "fileLocation": "relative",
                    "pattern": [
                        {
                            "regexp": "^(.*):(\\d+):(\\d+): (.*)$",
                            "file": 1,
                            "line": 2,
                            "column": 3,
                            "message": 4
                        }
                    ]
                }
            ]
        },
        {
            "label": "Build Short Resume",
            "type": "shell",
            "command": "latexmk",
            "args": [
                "-pdf",
                "-outdir=short",
                "short/vladimir_sirghi_short.tex"
            ],
            "problemMatcher": [
                {
                    "owner": "latex",
                    "fileLocation": "relative",
                    "pattern": [
                        {
                            "regexp": "^(.*):(\\d+):(\\d+): (.*)$",
                            "file": 1,
                            "line": 2,
                            "column": 3,
                            "message": 4
                        }
                    ]
                }
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "close": true
            }
        },
        {
            "label": "Build Both Resumes",
            "dependsOn": [
                "Build Short Resume",
                "Build Detailed Resume"
            ],
            "dependsOrder": "parallel",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}